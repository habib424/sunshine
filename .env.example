# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Anthropic API (required for AI-assisted file analysis) ──────────────────
# Get your key at: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Database ────────────────────────────────────────────────────────────────
# SQLite path (default works out of the box, no change needed)
DATABASE_URL=sqlite+aiosqlite:///./backend/storage/sunshine.db

# ── File storage ────────────────────────────────────────────────────────────
# Where uploaded files and outputs are stored
STORAGE_PATH=./backend/storage

# ── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL (change if you deploy on a different port)
CORS_ORIGINS=["http://localhost:5173"]
